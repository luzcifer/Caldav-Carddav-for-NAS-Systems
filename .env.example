# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MariaDB Primary Database Configuration (Master)
MARIADB_HOST=
MARIADB_PORT=3306
MARIADB_USER=
MARIADB_PASSWORD=
MARIADB_DATABASE=chronodav

# Optional Initial Admin Credentials for unattended Docker startup
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=

# Periodic SQLite Backup Configuration
BACKUP_INTERVAL_MINUTES=60
DATA_DIR=./data

# SMTP Email Alert Configuration for DB Outage & Recovery
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ALERT_EMAIL_TO=
